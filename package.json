{
  "name": "moviegen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev-server.mjs next dev",
    "build": "next build",
    "start": "node scripts/dev-server.mjs next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:dependencies": "node --test scripts/dependency-security.mjs scripts/dependency-match-security.mjs",
    "test:unit": "vitest run",
    "test": "pnpm test:dependencies && pnpm test:unit",
    "check:no-media": "scripts/check-no-media.sh",
    "test:production": "python3 -m unittest discover -s scripts -p test_production_gate.py",
    "production:check": "python3 scripts/production_gate.py",
    "build:production": "python3 scripts/production_gate.py build",
    "start:production": "python3 scripts/production_gate.py start --port auto"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@tabler/icons-react": "^3.50.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "patchedDependencies": {
      "minimatch@11.0.1": "patches/minimatch@11.0.1.patch",
      "eslint-plugin-import@2.32.0": "patches/eslint-plugin-import@2.32.0.patch"
    }
  }
}
